#!/bin/sh
set -eu
[ "${1:-}" != stop ] || exec systemctl --user stop fdrive.service
plugin="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
binary="${XDG_CACHE_HOME:-$HOME/.cache}/fdrive/$(cat "$plugin/revision")/fdrive"
if [ ! -x "$binary" ]; then
    mkdir -p "$(dirname -- "$binary")"
    (
        flock 9
        [ ! -x "$binary" ] || exit 0
        temporary=$(mktemp "$binary.XXXXXX")
        trap 'rm -f "$temporary"' EXIT
        curl -fsSL --connect-timeout 15 --max-time 120 https://downloads.filestash.app/latest/fdrive-linux-x86_64.bin -o "$temporary"
        chmod +x "$temporary"
        mv "$temporary" "$binary"
    ) 9>"$binary.lock"
fi
case "${1:-}" in
    start) systemctl --user start fdrive.service 2>/dev/null ||
        exec systemd-run --user --unit=fdrive --collect --property=Restart=on-failure --property=RestartSec=5 -- "$binary" daemon ;;
    *) exec "$binary" "$@" ;;
esac
